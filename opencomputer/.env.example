# Development agent secrets belong in .env.local beside this file.
# Only names referenced by useSecret() inside a defineConnection() belong here.

# Airtable personal access token, scoped data.records:write on your base.
# Create at https://airtable.com/create/tokens
AIRTABLE_TOKEN=

# base64("<ACCOUNT_SID>:<AUTH_TOKEN>"). Only used to page the on-call
# technician — replies to the caller go out through the channel.
TWILIO_BASIC_AUTH=
